<%- include('partials/header') -%>

<main class="container">
  <div class="row justify-content-center">
    <section class="col-6 mt-5">
      <h2 class="mb-4 text-center">Forgot Password</h2>

      <% if (locals.messages.errors) { %>
        <% messages.errors.forEach(el => { %>
          <div class="alert alert-danger"><%= el.msg %></div>
        <% }) %>
      <% } %>

      <% if (locals.messages.info) { %>
        <% messages.info.forEach(el => { %>
          <div class="alert alert-info"><%= el.msg %></div>
        <% }) %>
      <% } %>

      <form action="/forgot-password" method="POST">
        <div class="mb-3">
          <label for="email" class="form-label">Enter your email address</label>
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="you@example.com"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
      </form>

      <div class="mt-3 text-center">
        <a href="/login" class="text-decoration-none">Back to Login</a>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') -%>
<!-- This is the forgot password page where users can request a password reset link. -->
<!-- It includes a form for entering the email address and handles error and info messages. -->