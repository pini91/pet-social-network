<%- include('partials/header') -%>
<div class="container deleteAccount">
     <form class="deleteAccount" action="/settings/editName?_method=PUT" method="POST">
        <input type="text" placeholder="Change Username" name="newName">
        <button class="deleteAccountButton" >Submit</button>
    </form>
    <form action="/deleteAccount?_method=DELETE"
        method="POST"
        class="deleteAccount">
        <p>If you wish to delete your account, click on the delete account button.</p>
        <p> The changes will be permanent. If you wish to rejoin in the future just sign up again.</p>
        <button class="deleteAccountButton"><a class="deleteAccountButton">Delete Account</a></button>
    </form>
    
<%- include('partials/footer') -%>




