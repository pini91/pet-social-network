<%- include('partials/header') -%>
<div class="container">
  <div class="row mt-5">
      <div class="col-6">
          <div>
              <p><strong>User Name</strong>: <%= user.userName %></p>
              <p><strong>Email</strong>: <%= user.email %></p>
              <a href="/logout" class="col-3 btn btn-primary">Logout</a>
          </div>
          <div class="mt-5">
            <h2>Add a post</h2>
            <form action="/post/createPost" enctype="multipart/form-data" method="POST">   <!--Molter which is handling our image uploading wont work without enctype-->
              <div class="mb-3">
                  <label for="title" class="form-label">Title</label> 
                  <input type="text" class="form-control" id="title" name="title">  <!--This is the input for our tittle-->
              </div>
              <div class="mb-3">
                <label for="caption" class="form-label">Caption</label> <!--This is the input for the caption-->
                <textarea class="form-control" id="caption" name="caption"></textarea>
              </div>
              <div class="mb-3">
                <label for="imgUpload" class="form-label">Image</label> 
                <input type="file" class="form-control" id="imageUpload" name="file"> <!--This is the file upload, the file upload is just a normal input type file-->
              </div>
              <button type="submit" class="btn btn-primary" value="Upload">Submit</button>
            </form> <!--When we submit this form, is gonna be like any other traditional post req, were just gonna need some middleware to help us handle it-->
          </div>
      </div>
      <div class="col-6">
        <ul class="row list-unstyled">
        <% for(var i=0; i<posts.length; i++) {%>
          <li class="col-6 justify-content-between mt-5">
            <a href="/post/<%= posts[i]._id%>"> <!--here we have an anchor tag that takes me to /post/ID(of the post). When i click it it takes me to server.js(app.use(/post)).-->
              <img class="img-fluid" src="<%= posts[i].image%>">
            </a>
          </li>
        <% } %>
        </ul>
        <div class="row justify-content-center mt-5">
          <a class="btn btn-primary" href="/feed">Return to Feed</a>
        </div>  
      </div>  
    </div>
  </div>
</div>
<%- include('partials/footer') -%>