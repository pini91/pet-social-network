<%- include('partials/header') -%>
<div class="container profileContainer">
  <div class="d-flex justify-content-end ">
    <a style="font-size:24px" class="fa settings" href="/settings">&#xf013;</a>
  </div>  
  <div class="d-flex justify-content-end">
        <a href="/logout" class="col-1 btn btn-primary">Logout</a>
  </div>
  <div class="row mt-5">
      <div class="col-6 ">
          <a class="btn btn-primary col-3" href="/feed">Go to Feed</a>
        <div class="mt-4">
            <p class="text-capitalize"><strong>User Name</strong>: <%= user.userName %></p>
            <p><strong>Email</strong>: <%= user.email %></p>
        </div>
        <div class="mt-5">
          <h2>Add a post</h2>
          <form action="/post/createPost" enctype="multipart/form-data" method="POST">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label> 
                <input type="text" class="form-control" id="title" name="title">
            </div>
            <div class="mb-3">
              <label for="caption" class="form-label">Caption</label>
              <textarea class="form-control" id="caption" name="caption"></textarea>
            </div>
            <div class="mb-3">
              <label for="imgUpload" class="form-label">Image</label> 
              <input type="file" class="form-control" id="imageUpload" name="file">
            </div>
            <button type="submit" class="btn btn-primary" value="Upload">Submit</button>
          </form>
        </div>
      </div>
      <div class="col-6">
        <% if (posts.length > 0) { %>
          <div class="posts-grid">
             <ul class="row list-unstyled">
              <% for(var i=0; i<posts.length; i++) {%>
                <li class="col-6 justify-content-between mt-5">
                  <a href="/post/<%= posts[i]._id%>">
                    <img class="img-fluid" src="<%= posts[i].image%>">
                  </a>
                </li>
              <% } %>
              </ul>
          </div>
        <% } else { %>
          <!-- Empty state for no posts -->
          <div class="empty-state">
            <i class="fas fa-camera-retro"></i>
            <h4>No posts yet</h4>
            <p class="mb-4">Share your pet's first adorable moment with the world!</p>
            <!-- <button class="btn btn-modern btn-lg" onclick="toggleCreatePost()">
              <i class="fas fa-plus me-2"></i>Create Your First Post
            </button> -->
          </div>
        <% } %>




       
      </div>  
    </div>
     <!-- <div class="row justify-content-center mt-5 col-3"> -->
     <a class="btn btn-primary col-2" href="/feed">Go to Feed</a>
    <!-- </div>  -->
  </div>
</div>
<%- include('partials/footer') -%>