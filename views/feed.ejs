<%- include('partials/header') -%>   <!--we have a header and footerpartial in the view/partials so we dont have to repeat our selfs. Where we put our bootstrap -->
  <div class="container">
    <div class="row justify-content-center mt-5">
      <ul class="row list-unstyled">
        <% for(var i=0; i<posts.length; i++) {%>
          <li class="col-6 justify-content-between mt-5">
            <a href="/post/<%= posts[i]._id%>">  <!-- Leon hard coded the post in the url here. Thats the route he wanted to be, setted up in the server.js. So if you click in the image it will take you to the post with route /post/i1239hfbcvjnj(the id)-->
              <img class="img-fluid" src="<%= posts[i].image%>">
            </a>
          </li>
        <% } %>
        </ul>
    </div>
  </div>  
<%- include('partials/footer') -%>