<%- include('partials/header') -%>   <!--we have a header and footerpartial in the view/partials so we dont have to repeat our selfs. Where we put our bootstrap -->
  <div class="container">
    <div class="d-flex justify-content-end mb-3">
        <a href="/logout" class="btn btn-primary">
          <i class="fas fa-sign-out-alt me-2"></i>Logout
        </a>
    </div>
     <!-- <div class="row mb-4"> -->
      <div class="mb-3">
          <form class="d-flex gap-2" action="/search" method="POST">
            <input type="text" class="form-control" placeholder="Search..." name="search">
            <button type="submit" class="btn btn-outline-primary">
              <i class="fa fa-search"></i>
            </button>
          </form>
        </div>
    <!-- </div> -->
    <div class="container feedsContainer">
      <h2 class="New Feeds">Community Feed</h2>
    </div>
    <div>
    <!-- Posts Grid  -->
      <div class="posts-grid">

          <!-- Loop through posts and display them -->
          <% for(let i=0; i<posts.length; i++) {%>
            <div class="post-item">
                <a href="/post/<%= posts[i]._id%>">
                  <img  src="<%= posts[i].image%>" alt="<%= posts[i].title %>">
                  <div class="post-overlay">
                    <div class="w-100">
                       <h6 class="mb-2"><%= posts[i].title %></h6>
                       <div class="d-flex justify-content-between align-items-center">
                        <small>
                          <i class="fas fa-heart me-1"></i><%= posts[i].likes %> likes
                        </small>
                        <small>
                          <i class="fas fa-calendar me-1"></i>
                          <%= new Date(posts[i].createdAt).toLocaleDateString() %>
                        </small>
                      </div>
                    </div>
                  </div>

                </a>
           
              </div>
            <% } %>
       
        </div>

  </div>  
<%- include('partials/footer') -%>