<%- include('partials/header') -%>

<main class="container">
  <div class="row justify-content-center">
    <section class="col-6 mt-5">
      <h2 class="mb-4 text-center">Reset Your Password</h2>

      <% if (locals.messages.errors) { %>
        <% messages.errors.forEach(el => { %>
          <div class="alert alert-danger"><%= el.msg %></div>
        <% }) %>
      <% } %>

      <% if (locals.messages.info) { %>
        <% messages.info.forEach(el => { %>
          <div class="alert alert-info"><%= el.msg %></div>
        <% }) %>
      <% } %>

      <form action="/reset-password/<%= token %>" method="POST">
        <div class="mb-3">
          <label for="password" class="form-label">New Password</label>
          <input
            type="password"
            class="form-control"
            id="password"
            name="password"
            required
          />
        </div>
        <div class="mb-3">
          <label for="confirm" class="form-label">Confirm New Password</label>
          <input
            type="password"
            class="form-control"
            id="confirm"
            name="confirm"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary w-100">Reset Password</button>
      </form>
    </section>
  </div>
</main>

<%- include('partials/footer') -%>
<!-- This is the reset password page where users can set a new password after clicking the reset link. -->
<!-- It includes a form for entering the new password and confirmation, and handles error and info messages. -->
<!-- The token is passed in the URL to verify the user's request. -->
<!-- Ensure that the token is securely generated and validated in your backend logic. -->
<!-- This page is typically accessed after a user clicks a reset link sent to their email. -->