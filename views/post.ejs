<%- include('partials/header') -%>
<div class="container py-3">
  <nav class="mb-4">
    <a class="btn btn-primary" href="/feed">
      <i class="fa fa-arrow-left me-2"></i>Go to Feeds
    </a>
  </nav>
  
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="modern-card">
        <!-- User Info Section -->
        <div class="d-flex align-items-center gap-3 mb-4">
          <% if (profilePic) { %>
            <img 
              class="profile-picture-large"
              src="<%= profilePic.image %>"
              alt="User Image"
            />
          <% } else { %>
            <div class="user-avatar">
              <%= userCreator.userName.charAt(0).toUpperCase() %>
            </div>
          <% } %>
          <div>
            <h1 class="h4 mb-0">
              <a href="/friends/<%= userCreator.id %>" class="friend-name text-decoration-none fw-semibold text-primary">
                <%= userCreator.userName.charAt(0).toUpperCase()+userCreator.userName.slice(1)%>
              </a>
            </h1>
            <div class="d-flex align-items-center gap-2 text-muted">
              <small><%= post.title %></small>
              <span>•</span>
              <small><%= post.likes.length %> likes</small>
            </div>
          </div>
        </div>
        <!-- Post Image -->
        <div class="position-relative mb-3">
          <img class="img-fluid rounded" src="<%= post.image%>" alt="Post image" />
        </div>

        <!-- Post Actions -->
        <div class="row g-2 mb-3">
          <div class="col-6">
            <% if(!post.likes.includes(user.id)) {%>
              <form class="w-100" action="/post/likePost/<%= post.id %>" method="POST">
                <button class="btn btn-outline-primary w-100 rounded-pill" type="submit">
                  <i class="fa fa-heart me-2"></i>Like
                </button>
              </form>
            <% } %>
            <% if(post.likes.includes(user.id)) {%>
              <form class="w-100" action="/post/unlikePost/<%= post.id %>" method="POST">
                <button class="btn btn-primary w-100 rounded-pill" type="submit">
                  <i class="fa fa-heart-broken me-2"></i>Unlike
                </button>
              </form>
            <% } %>
          </div>
          
          <div class="col-6">
            <%if(post.user == user.id){ %>
              <form action="/post/deletePost/<%= post.id %>?_method=DELETE" method="POST" class="w-100">
                <button class="btn btn-outline-danger w-100 rounded-pill" type="submit">
                  <i class="fa fa-trash me-2"></i>Delete
                </button>
              </form>
            <%}%>
          </div>
        </div>

        <!-- Post Caption -->
        <% if(post.caption) { %>
          <div class="p-3 rounded mb-3">
            <p class="mb-0 "><%= post.caption %></p>
          </div>
        <% } %>
      <!-- </div> -->
    </div>
    <!-- Soft gray line after caption -->
    <hr class="my-4 opacity-25 w-90 mx-auto">
    <div class="mt-3"> <!-- Changed from mt-5 to mt-3 for better spacing -->
      <h5>Add a comment</h5>
      <form action="/comment/createComment/<%=post._id%>" method="POST"> <!--Here we can just pass the post._id because of the controller, where we already passed all the info about the post and all the info about the comments... basically says create a comment in this post-->
        <div class="mb-3">
            <!-- <label for="comment" class="form-label">Comment</label>  -->
            <input type="text" class="form-control" id="comment" name="comment">  <!--This is the input for our tittle-->
        </div>
        <button type="submit" class="btn btn-primary" value="Upload">Submit</button>
      </form> 
    </div>
    <div class="comments-section">
      <ul class="list-unstyled">
        <% for(let i=0; i<comments.length; i++) {%>
          <li class="comment-container mb-2">
            <div class="d-flex align-items-start gap-2">
              <!-- User Avatar -->
              <% const proPic = profilePics.find(photo => photo.user.toString() === comments[i].userCommentCreator.id.toString()); %>
              <img class="profile-picture-small rounded-circle" src="<%= proPic ? proPic.image : '/imgs/icons8-dog-paw-32.png' %>" alt="User Image">
              
              <!-- Comment Content -->
              <div class="comment-content flex-grow-1"><!-- flex-grow-1 is used to control how a flex item within a flex container expands to fill available space. -->
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <a href="/friends/<%= comments[i].userCommentCreator.id %>" class="friend-name text-capitalize text-decoration-none fw-semibold"><%= comments[i].userCommentCreator.userName%></a>
                  <small class="text-muted"><%= comments[i].createdAt.toLocaleString().slice(0, 9)%></small>
                </div>
                <p class="mb-1"><%= comments[i].comment%></p>
                
                <!-- Delete Button (if user's comment) -->
                <% if(comments[i].userCommentCreator.id == user.id) {%>
                  <div class="comment-actions">
                    <form action="/comment/deleteComment/<%= comments[i]._id %>?_method=DELETE" method="POST" class="d-inline">
                      <button class="btn btn-sm text-danger border-0 p-0" type="submit">
                        <i class="fa fa-trash"></i>
                      </button>
                    </form>
                  </div>
                <%}%>
              </div>
            </div>
          </li>
        <% } %>
      </ul>
    </div>
    </div>
    <!-- Soft gray line after comments -->
    <!-- <hr class="my-4 opacity-25 w-90 mx-auto"> -->
    <div class="mt-3">
      <a class="btn btn-primary me-2" href="/profile">Go to Profile</a>
      <a class="btn btn-primary" href="/feed"><i class="fas fa-stream me-2"></i>Go to Feeds </a>
    </div>
  </div>
</div>

<%- include('partials/footer') -%>
