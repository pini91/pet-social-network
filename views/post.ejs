<%- include('partials/header') -%>
<div class="container">
  <!-- <div class="d-flex justify-content-end">
        <a href="/logout" class="col-1 btn btn-primary">Logout</a>
  </div> -->
  <div class="d-flex justify-content-start">
    <a class="btn btn-primary" href="/feed">Go to Feed</a>
  </div>
  <div class="row justify-content-center mt-5">
    <div class="col-6">
      <div class="row justify-content-between">
         <% if (profilePic) { %>
          <div class="">
               <img 
                   class="profile-picture-large"
                   src="<%= profilePic.image %>"
                   alt="User Image"
               />
          </div>
             <% } else { %>
               <div class="user-avatar">
                <%= userCreator.userName.charAt(0).toUpperCase() %>
              </div>
             <% } %>
      <h1><a href="/friends/<%= userCreator.id %>" class="friend-name text-decoration-none fw-semibold text-primary"><%= userCreator.userName.charAt(0).toUpperCase()+userCreator.userName.slice(1)%></a></h1>
      <div class="mt-4 d-flex justify-content-between">
          <h3 class="h5"><%= post.title %></h3>
          <h5 class="col-3">Likes: <%= post.likes.length %></h5><!--This shows me how many likes there is.(We take them from the db)-->
      </div>
      
      <img class="img-fluid" src="<%= post.image%>" />
       <div class="col-3 mt-5">
        <p class="h5"><%= post.caption %></p>
      </div>
      <div class="row g-2">
        <div class="col-6">
          <% if(!post.likes.includes(user.id)) {%>
            <form
              class="w-100"
              action="/post/likePost/<%= post.id %>" 
              method="POST"
            >
              <button class="btn btn-outline-primary w-100" type="submit">
                <i class="fa fa-heart"></i> Like
              </button>
            </form>
          <% } %>
          <% if(post.likes.includes(user.id)) {%>
            <form
              class="w-100"
              action="/post/unlikePost/<%= post.id %>"
              method="POST"
            >
              <button class="btn btn-outline-primary w-100" type="submit">
                <i class="fa fa-heart-broken"></i> Unlike
              </button>
            </form>
          <% } %>
        </div>
        
        <div class="col-6">
          <%if(post.user == user.id){ %>
            <form
              action="/post/deletePost/<%= post.id %>?_method=DELETE"
              method="POST"
              class="w-100"
            >
              <button class="btn btn-outline-primary w-100" type="submit">
                <i class="fa fa-trash"></i> Delete
              </button>
            </form>
          <%}%>
        </div>
      </div>
    </div>
   
    <div class="mt-5"> 
      <h5>Add a comment</h5>
      <form action="/comment/createComment/<%=post._id%>" method="POST"> <!--Here we can just pass the post._id because of the controller, where we already passed all the info about the post and all the info about the comments... basically says create a comment in this post-->
        <div class="mb-3">
            <!-- <label for="comment" class="form-label">Comment</label>  -->
            <input type="text" class="form-control" id="comment" name="comment">  <!--This is the input for our tittle-->
        </div>
        <button type="submit" class="btn btn-primary" value="Upload">Submit</button>
      </form> 
    </div>
    <ul>
      <% for(let i=0; i<comments.length; i++) {%>  <!--This comments are also comming from the post controller.-->
        <li class="col-6 d-flex mt-2 liComment">
        <!--Here we are going to show the comments, the user who made the comment, and the date when it was created.-->
          <!-- <div > -->


          <!-- here we are going to find the images for each user that made a comment -->
           <% const proPic = profilePics.find(photo => photo.user.toString() === comments[i].userCommentCreator.id.toString()); %>

          <img class="profile-picture-small" src="<%= proPic ? proPic.image : '/imgs/icons8-dog-paw-32.png' %>" alt="User Image">
            <!-- <span class="col-2"><a href="/friends/<%= comments[i].userCommentCreator.id %>"><%= comments[i].userCommentCreator.userName %></a></span> -->
          <!-- </div> -->
      
          <div class=" row mt-1 comment">
            <span class="col-2"><a href="/friends/<%= comments[i].userCommentCreator.id %>" class="friend-name text-capitalize"><%= comments[i].userCommentCreator.userName%></a></span>
            <span><%= comments[i].comment%></span>
          </div>
          <div class="d-flex justify-content-end " >
            <span><%= comments[i].createdAt.toLocaleString().slice(0, 9)%></span>
            <% if(comments[i].userCommentCreator.id == user.id) {%>
              <form
                action="/comment/deleteComment/<%= comments[i]._id %>?_method=DELETE"
                method="POST"
              >
                <button class="btn btn-outline-primary fa fa-trash" type="submit"></button>
              </form>
            <%}%>
          </div>
        
        </li>
      <% } %>
    </ul>
    <div class="col-6 mt-5">
      <a class="btn btn-primary" href="/profile">Go to Profile</a>
      <a class="btn btn-primary" href="/feed">Go to Feed</a>
    </div>
  </div>
</div>

<%- include('partials/footer') -%>
