<%- include('partials/header') -%>
 <!-- mainlayout starts here -->
  <div class="row g-4">  <!-- g-4 is a Bootstrap class that adds gutters (spacing) between columns This will gives us 2 columns-->
     <!-- Left Sidebar -->
    <div class="col-lg-4">
      <!-- User Info Card -->
     <div class="user-info-card">
      <!-- <div class="d-flex flex-column align-items-center text-center"> -->
        <form class="searchButton" action="/search" method="POST">
          <input type="text" placeholder="Search.." name="search">
          <button type="submit"><i class="fa fa-search"></i></button>
        </form>
        <a class="btn btn-primary col-8" href="/feed">Go to Feeds</a>
        <% if(isFollowing) {%>
          <form action="/friends/unfollow/<%= friendProfile._id %>?_method=DELETE" method="POST">
            <button class="fa fa-minus btn btn-danger col-3" type="submit">Unfollow Pet Friend</button>
          </form>
        <% } %>
        <% if(!isFollowing) {%>
           <form action="/friends/follow/<%= friendProfile._id %>?_method=PUT" method="POST">
           <div class="">
               <button class="fa fa-plus btn btn-primary col-3" type="submit">Follow Pet Friend</button>
           </div>
           </form>
       <% } %>
        <!-- user information card -->
        <div class="user-info-card mt-3">
          <div class="d-flex flex-column align-items-center text-center">

<!-- 
            <div class="user-avatar">
              <%= friendProfile.userName.charAt(0).toUpperCase() %>
            </div> -->

              <% if (proPic) { %>
               <img
                   class="profile-picture-large"
                   src="<%= proPic.image %>"
                   alt="User Image"
               />
              <% } else { %>
                <div class="user-avatar" >
                <%= friendProfile.userName.charAt(0).toUpperCase() %>
                </div>
              <% } %>


            <h3 class="mb-2 fw-bold"><%= friendProfile.userName.charAt(0).toUpperCase()+friendProfile.userName.slice(1) %></h3>
            <!-- <p class="mb-3 opacity-75"><%= friendProfile.email %></p> -->
            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">
              <i class="fas fa-users me-2"></i>Followers: <%= followedBy %>
            </span>
            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2 mt-2">
              <i class="fas fa-user-friends me-2"></i>Following: <%= follows %>
            </span>
          </div>
        </div>
      </div>

      
       
     
  </div>
   
    <!-- ---------------------------------------------- -->
      <!-- Posts Section -->
      <div class="col-lg-8">
        <div class="modern-card">
         <!-- Header -->
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0 fw-bold text-dark">
              <i class="fas fa-images me-2 text-primary"></i>Your Friends Gallery
            </h2>
            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">
              <%= posts.length %>
            </span>
      </div> 
        <!-- Posts Grid or Empty State -->
      <% if (posts.length > 0) { %>
        <div class="posts-grid">
          
            <!-- Loop through posts and display them -->
            <% for(var i=0; i<posts.length; i++) {%>
              <div class="post-item">
                <a href="/post/<%= posts[i]._id%>">
                  <img  src="<%= posts[i].image%>" alt="<%= posts[i].title %>">
                  <div class="post-overlay">
                    <div class="w-100">
                       <h6 class="mb-2"><%= posts[i].title %></h6>
                       <div class="d-flex justify-content-between align-items-center">
                        <small>
                          <i class="fas fa-heart me-1"></i><%= posts[i].likes %> likes
                        </small>
                        <small>
                          <i class="fas fa-calendar me-1"></i>
                          <%= new Date(posts[i].createdAt).toLocaleDateString() %>
                        </small>
                      </div>
                    </div>
                  </div>

                </a>
           
              </div>
            <% } %>
       
        </div>
      <% } else { %>
        <!-- Empty state for no posts -->
        <div class="empty-state">
          <i class="fas fa-camera-retro"></i>
          <h4>No posts yet</h4>
        </div>
      <% } %>  
      </div>
    </div>

     <!-- <div class="row justify-content-center mt-5 col-3"> -->
     <a class="btn btn-primary col-2" href="/feed">Go to Feed</a>
    <!-- </div>  -->
  </div>
</div>
  


<%- include('partials/footer') -%>