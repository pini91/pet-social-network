<%- include('partials/header') -%>   <!--we have a header and footerpartial in the view/partials so we dont have to repeat our selfs. Where we put our bootstrap -->
  <div class="container">
    <h3>Friends</h3>
    <div class="d-flex justify-content-end">
        <a href="/logout" class="col-1 btn btn-primary">Logout</a>
    </div>
    <div>
      <form class="" action="/search" method="POST">
        <input type="text" placeholder="Search.." name="search">
        <button type="submit"><i class="fa fa-search"></i></button>
        <i style="font-size:24px" class="fa"><a class="refresh" href="../feeds">&#xf021;</a></i>
      </form>
    </div>
    <div class="">
      <h2 class="New Feeds">New Feeds</h2>
    <div>
    <div class="d-flex justify-content-center mt-5">
      <ul class="row list-unstyled">
        <% for(var i=0; i<friends.length; i++) {%>
          <li class="col-6 justify-content-between mt-5">
             <img
                class="col-3 rounded-circle"
                src="<%= friends[i].image %>"
                alt="User Image"
              />
              <a href="/friends/<%= friends[i]._id %>" class="friend-name"> 
                <h3 class="text-capitalize"><%= friends[i].userName %></h3>
              </a>
          </li>
        <% } %>
        </ul>
    </div>
  </div>  
<%- include('partials/footer') -%>