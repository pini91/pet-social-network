<%- include('partials/header') -%>
  <div class="container">
    <!-- Top Navigation Bar -->
    <div class="d-flex justify-content-between align-items-center mt-4">
      <!-- Back to Feeds Button -->
      <div class="col-12 col-sm-4 col-md-3 col-lg-2">
        <a class="btn btn-primary w-100" href="/feed">
          <i class="fas fa-stream me-2"></i>Go to Feeds
        </a>
      </div>
      <!-- Logout Button -->
      <div>
        <a href="/logout" class="btn btn-gradient-danger">
          <i class="fas fa-sign-out-alt me-2"></i>Logout
        </a>
      </div>
    </div>
    <div>
      <form class="" action="/search" method="POST">
        <input type="text" placeholder="Find your friends..." name="search">
        <button type="submit" class="btn btn-outline-primary"><i class="fa fa-search"></i></button>
        <!-- <i style="font-size:24px" class="fa"><a class="refresh" href=""></a></i> -->
      </form>
      <h3 class="mt-4">Friends</h3>
    </div>
    <div>
    <div class="d-flex justify-content-center mt-3">
      <ul class="row list-unstyled">
        <% for(var i=0; i<friends.length; i++) {%>
          <li class="col-6 justify-content-between mt-5">

            <% const profilePic = photos.find(photo => photo.user.toString() === friends[i]._id.toString()); %>
             <img
                class="profile-picture-large"
                src="<%= profilePic ? profilePic.image :'/imgs/icons8-dog-paw-32.png'%>"
                alt="User Image"
              />


              <a href="/friends/<%= friends[i]._id %>" class="friend-name"> 
                <h3 class="text-capitalize"><%= friends[i].userName %></h3>
              </a>
          </li>
        <% } %>
        </ul>
    </div>
  </div>  
<%- include('partials/footer') -%>