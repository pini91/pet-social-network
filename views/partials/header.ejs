<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Pets Social Network - Share your pets best moments with a loving community of pet owners. Connect, share photos, and celebrate your furry friends!" />
    <meta name="keywords" content="pets, social network, pet photos, pet community, animal lovers, pet sharing" />
    <meta name="author" content="Pets Social Network" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Pets Social Network" />
    <meta property="og:description" content="Share your pets best moments with a loving community of pet owners" />
    <meta property="og:image" content="/imgs/icons8-dog-paw-32.png" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:title" content="Pets Social Network" />
    <meta property="twitter:description" content="Share your pets best moments with a loving community of pet owners" />
    
    <!-- PWA and Mobile Optimizations -->
    <meta name="theme-color" content="#007bff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Pet Social" />
    
    <title>Pets Social Network</title>
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/imgs/icons8-dog-paw-32.png"
    />
    <link
      rel="apple-touch-icon"
      href="/imgs/icons8-dog-paw-32.png"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css"  
      rel="stylesheet"
      integrity="sha384-eOJMYsd53ii+scO/bJGFsiCZc+5NDVN2yr8+0RDqr0Ql0h+rP48ckxlpbzKgwra6"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
