# Database
DB_STRING=mongodb+srv://username:password@cluster.mongodb.net/petnetwork

# Application
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=your-super-secret-session-key-here-change-this-in-production

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Railway MongoDB (if using Railway's MongoDB template)
# These will be automatically provided by Railway when you add a MongoDB service
# MONGOHOST=containers-us-west-200.railway.app
# MONGOPORT=7755
# MONGOUSER=mongo
# MONGOPASSWORD=random-password
# MONGO_URL=mongodb://mongo:random-password@containers-us-west-200.railway.app:7755

# Railway (these will be set automatically by Railway)
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=your-project-id
# RAILWAY_SERVICE_ID=your-service-id
